{
    "pipeline": {
        "nodes": [
            "GeometryModule",
            "ObjectModule",
            "DepthModule",
            "TemporalModule",
            "FreeSpaceModule",
            "EdgeSafetyModule",
            "OCRModule",
            "PathGuidanceModule",
            "SceneUnderstandingModule"
        ],
        "edges": [
            [
                "GeometryModule",
                "ObjectModule"
            ],
            [
                "GeometryModule",
                "PathGuidanceModule"
            ],
            [
                "GeometryModule",
                "EdgeSafetyModule"
            ],
            [
                "ObjectModule",
                "TemporalModule"
            ]
        ]
    },
    "modules": [
        {
            "name": "GeometryModule",
            "enabled": true,
            "params": {
                "safeZoneThreshold": "0.7",
                "interval": "30"
            }
        },
        {
            "name": "ObjectModule",
            "enabled": true,
            "params": {
                "modelPath": "build/Release/models/MobileNetSSD_deploy.caffemodel",
                "configPath": "build/Release/models/MobileNetSSD_deploy.prototxt",
                "threshold": "0.1",
                "eachFrame": "false",
                "interval": "5"
            }
        },
        {
            "name": "DepthModule",
            "enabled": true,
            "params": {
                "modelPath": "build/Release/models/midas-v2_1-small-192x256.onnx",
                "eachFrame": "false",
                "interval": "30"
            }
        },
        {
            "name": "TemporalModule",
            "enabled": true,
            "params": {
                "windowSize": "2",
                "decay": "0.85"
            }
        },
        {
            "name": "FreeSpaceModule",
            "enabled": true,
            "params": {
                "sectors": "3",
                "minClearance": "1.0"
            }
        },
        {
            "name": "EdgeSafetyModule",
            "enabled": true,
            "params": {
                "gradientThreshold": "0.25"
            }
        },
        {
            "name": "OCRModule",
            "enabled": true,
            "params": {
                "detectModel": "build/Release/models/text_detection_db.onnx",
                "recogModel": "build/Release/models/text_recognition_crnn.onnx",
                "interval": "35"
            }
        },
        {
            "name": "PathGuidanceModule",
            "enabled": true,
            "params": {
                "turnThreshold": "0.5"
            }
        },
        {
            "name": "SceneUnderstandingModule",
            "enabled": true,
            "params": {
                "modelPath": "build/Release/models/resnet18_places365.onnx",
                "classesPath": "build/Release/models/scene_classes.txt",
                "interval": "40"
            }
        }
    ]
}